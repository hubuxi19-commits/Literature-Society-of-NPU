# 边缘函数环境变量示例：只提交占位符，不提交真实值。
# 真实值通过 Supabase Dashboard 的 Edge Functions → Secrets 设置，
# 或通过 supabase CLI 的 `supabase secrets set` 设置。
# 不要把真实密钥粘贴到终端输出、聊天、截图或 Git 历史中。

ALLOWED_ORIGINS=http://127.0.0.1:4173
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=文苑账号安全

# 以下为秘密：示例中必须保持空值。
BREVO_API_KEY=
TURNSTILE_SECRET_KEY=
ACCOUNT_TOKEN_PEPPER=
AUTH_RATE_LIMIT_PEPPER=
